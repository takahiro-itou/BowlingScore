<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>WinExe</OutputType>
    <Platforms>x86;x64</Platforms>
    <RootNamespace>BowlingScoreView</RootNamespace>
    <TargetFrameworks>
      net48;
    </TargetFrameworks>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)\..\Props\OutputApps.props" />

  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <ProjectReference Include="..\Wrapper\Wrapper.Net48.vcxproj" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)\Targets.props" />

  <ItemGroup>
    <Reference Include="mscorlib" />
  </ItemGroup>

</Project>
