
<Window x:Class="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:ViewVb"
    xmlns:r="clr-namespace:ViewVb.Lang"
    xmlns:WpfControl.Sample="clr-namespace:WpfControl.Sample;assembly=WpfControl"
    Title="{x:Static r:Strings.MainWindowTitle}"
    Height="448" Width="384"
>
  <Window.Icon>
    <Binding
        Source="Resources/MainWindowEmbedded.ico"
        FallbackValue="{x:Null}"
        TargetNullValue="{x:Null}" />
  </Window.Icon>

  <StackPanel Orientation="Vertical">
  </StackPanel>

</Window>
