<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <OutputType>WinExe</OutputType>
    <Platforms>x64;x86</Platforms>
    <RootNamespace>BowlingScoreView</RootNamespace>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)\..\Props\OutputApps.props" />

  <ItemGroup>
    <ProjectReference Include="..\Wrapper\Wrapper.Net80.vcxproj" />
  </ItemGroup>
  <ItemGroup>
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)\Targets.props" />

</Project>
